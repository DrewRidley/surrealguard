{
  "name": "@surrealdb/analyzer-query",
  "version": "0.5.3",
  "description": "Framework-agnostic reactive core for SurrealQL Analyzer: cache, dedup, live reconciliation, SSR hydration.",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "author": "Drew Ridley",
  "repository": {
    "type": "git",
    "url": "https://github.com/surrealdb/analyzer",
    "directory": "packages/query"
  },
  "keywords": [
    "surrealdb",
    "surrealql",
    "live-query",
    "reactive",
    "cache"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@surrealdb/analyzer-client": "0.5.3"
  },
  "peerDependencies": {
    "surrealdb": "^2.0.8"
  },
  "devDependencies": {
    "surrealdb": "2.0.8"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
