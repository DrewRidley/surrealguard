{
  "name": "@surrealguard/next",
  "version": "0.4.0",
  "description": "Next.js / React bindings for SurrealGuard: typed live queries as hooks, App Router SSR seeding.",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "author": "Drew Ridley",
  "repository": {
    "type": "git",
    "url": "https://github.com/DrewRidley/surrealguard",
    "directory": "packages/next"
  },
  "keywords": [
    "surrealdb",
    "surrealql",
    "next",
    "react",
    "live-query"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@surrealguard/client": "0.4.0",
    "@surrealguard/query": "0.4.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "surrealdb": "^2.0.8"
  },
  "devDependencies": {
    "@testing-library/react": "^14",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "jsdom": "^25",
    "react": "^18",
    "react-dom": "^18",
    "surrealdb": "2.0.8"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
