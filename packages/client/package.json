{
  "name": "@surrealguard/client",
  "version": "0.5.1",
  "description": "Typed SurrealQL client \u2014 literal queries resolve their result and params from generated types.",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "author": "Drew Ridley",
  "repository": {
    "type": "git",
    "url": "https://github.com/DrewRidley/surrealguard",
    "directory": "packages/client"
  },
  "keywords": [
    "surrealdb",
    "surrealql",
    "typescript",
    "types"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "surrealdb": "^2.0.8"
  },
  "devDependencies": {
    "surrealdb": "2.0.8"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external surrealdb",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
