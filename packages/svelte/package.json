{
  "name": "@surrealguard/svelte",
  "version": "0.5.1",
  "description": "Svelte 5 / SvelteKit bindings for SurrealGuard: typed live queries as runes, SSR hydration.",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "author": "Drew Ridley",
  "repository": {
    "type": "git",
    "url": "https://github.com/DrewRidley/surrealguard",
    "directory": "packages/svelte"
  },
  "keywords": [
    "surrealdb",
    "surrealql",
    "svelte",
    "sveltekit",
    "runes",
    "live-query"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./transport": {
      "types": "./dist/transport.d.ts",
      "svelte": "./dist/transport.js",
      "default": "./dist/transport.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@surrealguard/client": "0.5.1",
    "@surrealguard/query": "0.5.1"
  },
  "peerDependencies": {
    "svelte": "^5",
    "surrealdb": "^2.0.8",
    "@sveltejs/kit": "^2"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@testing-library/svelte": "^5.2.4",
    "jsdom": "^25",
    "surrealdb": "2.0.8",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.0"
  },
  "scripts": {
    "build": "svelte-package --input src --output dist",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "peerDependenciesMeta": {
    "@sveltejs/kit": {
      "optional": true
    }
  }
}
