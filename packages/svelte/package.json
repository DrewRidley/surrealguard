{
  "name": "@surrealguard/svelte",
  "version": "0.2.0",
  "description": "Svelte / SvelteKit bindings for SurrealGuard: typed queries, live stores, SSR hydration.",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "author": "Drew Ridley",
  "repository": {
    "type": "git",
    "url": "https://github.com/DrewRidley/surrealguard",
    "directory": "packages/svelte"
  },
  "keywords": ["surrealdb", "surrealql", "svelte", "sveltekit", "live-query"],
  "sideEffects": false,
  "files": ["dist", "LICENSE-MIT", "LICENSE-APACHE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@surrealguard/client": "workspace:*",
    "@surrealguard/query": "workspace:*"
  },
  "peerDependencies": {
    "svelte": ">=4",
    "surrealdb": "^2.0.8"
  },
  "devDependencies": {
    "jsdom": "^25",
    "surrealdb": "2.0.8",
    "svelte": "^4"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external svelte",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
