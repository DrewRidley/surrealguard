# SurrealGuard precision snapshot — every inferred type the corpus produces.
#
# Regenerate: UPDATE_SNAPSHOTS=1 cargo test -p surrealguard-workspace --test precision_snapshot
#
# This file records CURRENT behaviour, not correct behaviour. A diff means a
# type changed: read it, decide whether the change is an improvement, and only
# then accept it. Silent acceptance defeats the whole harness.
#
# This is the SG_FACT_LAYER=1 variant: the same corpus, narrowed by the
# expression-fact layer instead of the hand-written recognizers. Diff it
# against `precision.snap` to read what the layer buys.

== schema: tables ==
table account  [schemafull]
  field active                       : bool  [default]
  field created_at                   : datetime  [default]
  field deactivated_reason           : option<string | null>
  field email                        : string
  field person                       : option<record<person>>
  field settings                     : { locale: option<string>, notify: bool, timezone: string }  [default]
  field updated_at                   : datetime  [computed, default]
  field username                     : string
table assigned_to  [schemafull, relation organization_unit -> organization_role]
  field weight                       : int  [default]
table document  [schemafull]
  field keywords                     : set<string>
  field length_band                  : string  [computed, default]
  field length_band_eq               : string  [computed, default]
  field owner                        : record<account | organization>
  field reviewer                     : option<record<account | organization>>
  field stage                        : 'draft' | 'review' | 'published'  [default]
  field summary                      : option<string | null>
  field tags                         : option<array<string>>
  field title                        : string
  field word_count                   : option<int>
  field word_count_or_zero           : int  [computed, default]
table document_audit  [schemafull]
  field note                         : record<document_note>
table document_note  [schemafull]
  field author                       : record<account>
  field before_body                  : string  [computed, default]
  field body                         : string
  field self_body                    : string  [computed, default]
  field this_body                    : string  [computed, default]
  field trimmed                      : string  [computed, default]
table employee_of  [schemafull, relation account -> organization]
  field joined_at                    : datetime  [default]
  field role                         : record<organization_role>
  field status                       : 'invited' | 'active' | 'suspended'  [default]
  field title                        : option<string>
  field unit                         : record<organization_unit>
table milestone  [schemafull]
  field label                        : string
  field project                      : record<project>  [reference]
table organization  [schemafull]
  field address                      : { city: string, country: string, line1: string, line2: option<string> }
  field contacts                     : array<{ email: string, label: string, primary: bool }>  [default]
  field created_at                   : datetime  [default]
  field employees                    : array<record<employee_of>>  [computed, default]
  field legal_name                   : string
  field logo                         : option<string>
  field name                         : string
  field owner                        : record<account>
  field parent                       : option<record<organization>>  [reference]
  field sectors                      : array<record<sector>>  [default]
  field subsidiaries                 : array<record<organization>>  [computed, default]
  field tier                         : 'free' | 'pro' | 'enterprise'  [default]
table organization_permission  [schemafull]
  field name                         : string
table organization_role  [schemafull]
  field name                         : string
  field organization                 : record<organization>
  field permissions                  : array<record<organization_permission>>  [default]
table organization_settings  [schemafull]
  field data_region                  : 'us' | 'eu'  [computed, default]
  field organization                 : record<organization>
  field retention_days               : 30 | 90 | 365  [default]
  field security                     : { byok: { kms_provider: option<string>, mode: 'lazy' | 'immediate', progress: int, status: 'not_started' | 'running' | 'completed' | 'failed' } }
  field updated_at                   : datetime  [computed, default]
table organization_unit  [schemafull]
  field headcount                    : int  [default]
  field name                         : string
  field organization                 : record<organization>
  field parent                       : option<record<organization_unit>>
table person  [schemafull]
  field created_at                   : datetime  [default]
  field date_of_birth                : option<datetime>
  field first_name                   : string
  field full_name                    : string  [computed, default]
  field last_name                    : string
  field middle_name                  : option<string>
table project  [schemafull]
  field milestones                   : array<record<milestone>>  [computed, default]
  field name                         : string
  field tasks                        : array<record<task>>  [computed, default]
  field unlinked                     : unknown  [computed, default]
table sector  [schemafull]
  field name                         : string
table task  [schemafull]
  field project                      : record<project>  [reference]
  field title                        : string
table webhook_event  [schemafull]
  field headers                      : object
  field payload                      : any
  field provider                     : 'stripe' | 'github'
  field received_at                  : datetime  [default]

== schema: functions ==
  fn::account::reason_or_default($r: option<string | null>) -> string  [inferred]
  fn::account::reason_set($r: option<string | null>) -> string | null  [inferred]
  fn::account::reason_uncleared($r: option<string | null>) -> option<string>  [inferred]
  fn::facts::guard_alias($v: option<string>) -> option<string>  [inferred]
  fn::facts::guard_alias_after($v: option<string>) -> string  [inferred]
  fn::facts::guard_field_path($o: { name: option<string> }) -> string  [inferred]
  fn::facts::guard_is_none($v: option<string>) -> string  [inferred]
  fn::facts::guard_is_not_none($v: option<string>) -> string  [inferred]
  fn::facts::guard_not($v: option<string>) -> string  [inferred]
  fn::facts::guard_paren($v: option<string>) -> string  [inferred]
  fn::facts::guard_return($v: option<string>) -> string  [inferred]
  fn::facts::guard_throw_block($v: option<string>) -> string  [inferred]
  fn::facts::guard_throw_then($v: option<string>) -> string  [inferred]
  fn::facts::guard_truthy($v: option<string>) -> string  [inferred]
  fn::facts::guard_type_is_none($v: option<string>) -> string  [inferred]
  fn::facts::guard_type_is_string($v: option<string>) -> string  [inferred]
  fn::facts::is_none_guard($r: option<string | null>) -> string | null  [inferred]
  fn::facts::is_null_guard($r: option<string | null>) -> option<string>  [inferred]
  fn::facts::not_ne_none_guard($r: option<string | null>) -> string | null  [inferred]
  fn::facts::not_ne_null_guard($r: option<string | null>) -> option<string>  [inferred]
  fn::org::display_name($org: record<organization>) -> string  [declared]
  fn::org::headcount($org: record<organization>) -> int  [inferred]
  fn::org::is_pro($org: record<organization>) -> bool  [inferred]
  fn::org::label($org: record<organization>) -> string  [inferred]
  fn::org::owner($org: record<organization>) -> record<account>  [inferred]
  fn::person::initials($first: string, $last: string) -> string  [inferred]

== schema: params ==
  $default_tier

== schema: analyzers ==
  simple  tokenizers=[blank, class] filters=[lowercase, ascii]

