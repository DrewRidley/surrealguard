# SurrealGuard precision snapshot — every inferred type the corpus produces.
#
# Regenerate: UPDATE_SNAPSHOTS=1 cargo test -p surrealguard-workspace --test precision_snapshot
#
# This file records CURRENT behaviour, not correct behaviour. A diff means a
# type changed: read it, decide whether the change is an improvement, and only
# then accept it. Silent acceptance defeats the whole harness.

== schema: tables ==
table account  [schemafull]
  field active                       : bool  [default]
  field created_at                   : datetime  [default]
  field email                        : string
  field person                       : option<record<person>>
  field settings                     : { locale: option<string>, notify: bool, timezone: string }  [default]
  field updated_at                   : datetime  [computed, default]
  field username                     : string
table assigned_to  [schemafull, relation organization_unit -> organization_role]
  field weight                       : int  [default]
table employee_of  [schemafull, relation account -> organization]
  field joined_at                    : datetime  [default]
  field role                         : record<organization_role>
  field status                       : 'invited' | 'active' | 'suspended'  [default]
  field title                        : option<string>
  field unit                         : record<organization_unit>
table organization  [schemafull]
  field address                      : { city: string, country: string, line1: string, line2: option<string> }
  field contacts                     : array<{ email: string, label: string, primary: bool }>  [default]
  field created_at                   : datetime  [default]
  field employees                    : unknown  [computed, default]
  field legal_name                   : string
  field logo                         : option<string>
  field name                         : string
  field owner                        : record<account>
  field parent                       : option<record<organization>>  [reference]
  field sectors                      : array<record<sector>>  [default]
  field subsidiaries                 : array<record<organization>>  [computed, default]
  field tier                         : 'free' | 'pro' | 'enterprise'  [default]
table organization_permission  [schemafull]
  field name                         : string
table organization_role  [schemafull]
  field name                         : string
  field organization                 : record<organization>
  field permissions                  : array<record<organization_permission>>  [default]
table organization_settings  [schemafull]
  field organization                 : record<organization>
  field security                     : { byok: { kms_provider: option<string>, mode: 'lazy' | 'immediate', progress: int, status: 'not_started' | 'running' | 'completed' | 'failed' } }
  field updated_at                   : datetime  [computed, default]
table organization_unit  [schemafull]
  field headcount                    : int  [default]
  field name                         : string
  field organization                 : record<organization>
  field parent                       : option<record<organization_unit>>
table person  [schemafull]
  field created_at                   : datetime  [default]
  field date_of_birth                : option<datetime>
  field first_name                   : string
  field full_name                    : string  [computed, default]
  field last_name                    : string
  field middle_name                  : option<string>
table sector  [schemafull]
  field name                         : string
table webhook_event  [schemafull]
  field headers                      : object
  field payload                      : any
  field provider                     : 'stripe' | 'github'
  field received_at                  : datetime  [default]

== schema: functions ==
  fn::org::display_name($org: record<organization>) -> string  [declared]
  fn::org::headcount($org: record<organization>) -> int  [inferred]
  fn::org::is_pro($org: record<organization>) -> bool  [inferred]
  fn::org::label($org: record<organization>) -> string  [inferred]
  fn::org::owner($org: record<organization>) -> record<account>  [inferred]
  fn::person::initials($first: string, $last: string) -> string  [inferred]

== schema: params ==
  $default_tier

== schema: analyzers ==
  simple  tokenizers=[blank, class] filters=[lowercase, ascii]

