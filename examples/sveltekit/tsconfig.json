{
  // Generated by `svelte-kit sync`, which the `typecheck` script runs first.
  // It supplies the `$lib` / `$app` aliases, the `.svelte-kit` route types and
  // the right `moduleResolution` for the adapter.
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  }
}
