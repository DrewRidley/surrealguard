{
  "name": "@surrealql-analyzer-example/sveltekit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Runnable SvelteKit / Svelte 5 SurrealQL Analyzer demo: reactive parameters, live queries, nesting, record-level access control.",
  "scripts": {
    "db": "node scripts/db.mjs",
    "db:seed": "node scripts/db.mjs --seed-only",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "generate": "surrealql-analyzer generate --out src/lib/surrealql-analyzer.generated.ts",
    "generate:watch": "surrealql-analyzer generate --out src/lib/surrealql-analyzer.generated.ts --watch",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@surrealdb/analyzer-client": "workspace:*",
    "@surrealdb/analyzer-query": "workspace:*",
    "@surrealdb/analyzer-svelte": "workspace:*",
    "surrealdb": "2.0.8"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^5.4.21"
  }
}
