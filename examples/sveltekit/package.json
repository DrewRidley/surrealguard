{
  "name": "@surrealguard-example/sveltekit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Runnable SvelteKit / Svelte 5 SurrealGuard demo: reactive parameters, live queries, nesting, record-level access control.",
  "scripts": {
    "db": "node scripts/db.mjs",
    "db:seed": "node scripts/db.mjs --seed-only",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "generate": "surrealguard generate --out src/lib/surrealguard.generated.ts",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@surrealguard/client": "workspace:*",
    "@surrealguard/query": "workspace:*",
    "@surrealguard/svelte": "workspace:*",
    "surrealdb": "2.0.8"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.21"
  }
}
